{application, parvi, [
    {description, "Parvi Audio experimental chat actors"},
    {vsn, "0.1.0"},
    {registered, [parvi_sup, parvi_pg, parvi_chat, parvi_discovery, parvi_relay, parvi_network, parvi_swarms]},
    {mod, {parvi_app, []}},
    {applications, [kernel, stdlib, inets, crypto, gun]},
    {env, [{default_reception_desk_url, <<"wss://parvi-reception-desk.onrender.com/relay/v1">>}]},
    {licenses, ["Apache-2.0"]}
]}.
