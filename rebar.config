%% Workspace-wide Erlang checks. Individual apps also build independently.
{project_app_dirs, ["control", "Services/ReceptionDesk"]}.
{base_dir, "builds/intermediates/erlang"}.
{erl_opts, [debug_info, warnings_as_errors]}.
{deps, [{gun, "2.7.0"}, {cowlib, {git, "https://github.com/ninenines/cowlib", {ref, "4401b858f2229abb3ea115c60924f6c77e5f8aa3"}}}]}.
